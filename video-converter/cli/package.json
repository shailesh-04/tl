{
  "name": "video-converter-cli",
  "version": "1.0.0",
  "description": "Terminal video converter using FFmpeg - convert mp4, webm, mov, mkv, avi, gif, mp3",
  "main": "index.js",
  "bin": {
    "vcli": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "help": "node index.js --help"
  },
  "keywords": [
    "video",
    "converter",
    "ffmpeg",
    "cli",
    "terminal"
  ],
  "author": "shailesh-04",
  "license": "MIT",
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "glob": "^10.4.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
